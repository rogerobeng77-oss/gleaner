        <mxCell id="title" value="&lt;b&gt;Gleaner&lt;/b&gt; — an autonomous food-rescue coordinator" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#201515;" vertex="1" parent="1">
          <mxGeometry x="330" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The agent places what it can. It stops when the call is genuinely a person's." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5C5551;" vertex="1" parent="1">
          <mxGeometry x="330" y="38" width="500" height="20" as="geometry" />
