        <mxCell id="inbox" value="&lt;b&gt;Held for a human&lt;/b&gt;&lt;br&gt;the rule that fired, in plain English&lt;br&gt;answered, the run resumes&lt;br&gt;exactly where it paused" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FBEAE7;strokeColor=#B62A1B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#201515;" vertex="1" parent="1">
          <mxGeometry x="810" y="960" width="290" height="125" as="geometry" />
        </mxCell>

        <!-- ============================ note ============================ -->
        <mxCell id="note" value="&lt;b&gt;Two rules ignore the autonomy dial.&lt;/b&gt;&lt;br&gt;liability_uncertain and dietary_conflict fire at every&lt;br&gt;level and cannot be loosened. Food safety and dietary&lt;br&gt;consent are not preferences — an eval suite asserts it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8E2DC;align=left;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fontColor=#5C5551;" vertex="1" parent="1">
